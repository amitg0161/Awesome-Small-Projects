# auto prefers OpenAI when keyed, otherwise uses local Ollama without an API key.
# Use demo for deterministic offline tests, or force openai/ollama explicitly.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen:latest
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=512

# Set a long random value before exposing the service beyond localhost.
API_KEY=
AUTOMATION_DB_PATH=data/runs.db
LOG_LEVEL=INFO